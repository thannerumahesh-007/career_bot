# =====================================================================
# CareerBot Environment Variables Template
# Copy this file to '.env' and populate with your own values:
# cp .env.example .env
# DO NOT COMMIT YOUR REAL '.env' FILE TO GITHUB OR VERSION CONTROL.
# =====================================================================

# Flask Secret Key for secure session cookies and CSRF protection
# Generate a cryptographically strong random string for production
SECRET_KEY=your_secure_random_flask_secret_key_here

# Database URI (defaults to SQLite if left empty or commented out)
# Local SQLite default:
DATABASE_URI=sqlite:///careerbot.db
# Cloud PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google Gemini API Key (Optional)
# Obtain from: https://aistudio.google.com/
# Leave blank to run CareerBot with its built-in offline NLP/rule-based fallback
GEMINI_API_KEY=your_gemini_api_key_here

# News API Key (Optional)
# Obtain from: https://newsapi.org/
# Used for live tech & corporate news feed; offline fallback available if omitted
NEWS_API_KEY=your_news_api_key_here

# Job Search API Keys (Optional - CareerBot includes built-in live job search via Arbeitnow & RemoteOK)
# Configurable for external job APIs (e.g., Adzuna, JSearch):
JOB_SEARCH_API_KEY=your_job_search_api_key_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Environment and Debug Configuration
# Set to 'production' on deployment, 'development' on local machine
FLASK_ENV=production
FLASK_DEBUG=false

# Port Configuration (defaults to 5000; cloud platforms like Render set this automatically)
PORT=5000
